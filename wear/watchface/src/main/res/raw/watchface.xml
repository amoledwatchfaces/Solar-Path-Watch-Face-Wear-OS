<?xml version="1.0" encoding="UTF-8"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
    <Metadata key="PREVIEW_TIME" value="10:08:32"/>

    <Scene>
        <!-- Background -->
        <PartDraw width="450" height="450" x="0" y="0">
            <Rectangle width="450" height="450" x="0" y="0">
                <Fill color="#000000"/>
            </Rectangle>
        </PartDraw>

        <!-- 24-Hour Solar Path Ring -->
        <PartDraw width="450" height="450" x="0" y="0">
            <Variant mode="AMBIENT" target="alpha" value="120"/>

            <!-- 1. Civil Twilight Dusk: Sunset -> Civil Dusk (-6°) -->
            <Arc centerX="225" centerY="225" width="370" height="370" startAngle="0" endAngle="0">
                <Transform target="startAngle" value="[REFERENCE.ss_angle]"/>
                <Transform target="endAngle" value="[REFERENCE.cdusk_angle]"/>
                <Stroke color="#e65100" thickness="36" cap="BUTT"/>
            </Arc>

            <!-- 2. Nautical Twilight Dusk: Civil Dusk (-6°) -> Nautical Dusk (-12°) -->
            <Arc centerX="225" centerY="225" width="370" height="370" startAngle="0" endAngle="0">
                <Transform target="startAngle" value="[REFERENCE.cdusk_angle]"/>
                <Transform target="endAngle" value="[REFERENCE.ndusk_angle]"/>
                <Stroke color="#283593" thickness="36" cap="BUTT"/>
            </Arc>

            <!-- 3. Astronomical Twilight Dusk: Nautical Dusk (-12°) -> Astro Dusk / Night (-18°) -->
            <Arc centerX="225" centerY="225" width="370" height="370" startAngle="0" endAngle="0">
                <Transform target="startAngle" value="[REFERENCE.ndusk_angle]"/>
                <Transform target="endAngle" value="[REFERENCE.adusk_angle]"/>
                <Stroke color="#1a237e" thickness="36" cap="BUTT"/>
            </Arc>

            <!-- 4. Full Night: Astro Dusk (-18°) -> Astro Dawn (-18°) through Midnight 180° -->
            <Arc centerX="225" centerY="225" width="370" height="370" startAngle="0" endAngle="0">
                <Transform target="startAngle" value="[REFERENCE.adusk_angle]"/>
                <Transform target="endAngle" value="[REFERENCE.adawn_angle]"/>
                <Stroke color="#151b26" thickness="36" cap="BUTT"/>
            </Arc>

            <!-- 5. Astronomical Twilight Dawn: Astro Dawn (-18°) -> Nautical Dawn (-12°) -->
            <Arc centerX="225" centerY="225" width="370" height="370" startAngle="0" endAngle="0">
                <Transform target="startAngle" value="[REFERENCE.adawn_angle]"/>
                <Transform target="endAngle" value="[REFERENCE.ndawn_angle]"/>
                <Stroke color="#1a237e" thickness="36" cap="BUTT"/>
            </Arc>

            <!-- 6. Nautical Twilight Dawn: Nautical Dawn (-12°) -> Civil Dawn (-6°) -->
            <Arc centerX="225" centerY="225" width="370" height="370" startAngle="0" endAngle="0">
                <Transform target="startAngle" value="[REFERENCE.ndawn_angle]"/>
                <Transform target="endAngle" value="[REFERENCE.cdawn_angle]"/>
                <Stroke color="#283593" thickness="36" cap="BUTT"/>
            </Arc>

            <!-- 7. Civil Twilight Dawn: Civil Dawn (-6°) -> Sunrise (0°) -->
            <Arc centerX="225" centerY="225" width="370" height="370" startAngle="0" endAngle="0">
                <Transform target="startAngle" value="[REFERENCE.cdawn_angle]"/>
                <Transform target="endAngle" value="[REFERENCE.sr_angle]"/>
                <Stroke color="#e65100" thickness="36" cap="BUTT"/>
            </Arc>

            <!-- 8. Daylight: Sunrise (0°) -> Sunset (0°) through Noon 0° -->
            <Arc centerX="225" centerY="225" width="370" height="370" startAngle="0" endAngle="0">
                <Transform target="startAngle" value="[REFERENCE.sr_angle]"/>
                <Transform target="endAngle" value="[REFERENCE.ss_angle]"/>
                <Stroke color="#1976d2" thickness="36" cap="BUTT"/>
            </Arc>

            <!-- Solar Ring Concentric Accent Borders -->
            <Arc centerX="225" centerY="225" width="408" height="408" startAngle="0" endAngle="360">
                <Stroke color="#37474f" thickness="2" cap="ROUND"/>
            </Arc>
            <Arc centerX="225" centerY="225" width="332" height="332" startAngle="0" endAngle="360">
                <Stroke color="#263238" thickness="2" cap="ROUND"/>
            </Arc>
        </PartDraw>

        <!-- Horizon Line Dividing Day & Twilight/Night -->
        <PartDraw width="450" height="450" x="0" y="0">
            <Variant mode="AMBIENT" target="alpha" value="120"/>
            <Line startX="20" startY="225" endX="430" endY="225">
                <Stroke color="#78909c" thickness="1" dashIntervals="4 4"/>
            </Line>
        </PartDraw>

        <!-- 24-Hour Markers (12 Noon Top, 24 Midnight Bottom, 6 Sunrise Left, 18 Sunset Right) -->
        <PartText width="60" height="24" x="195" y="14">
            <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="14" color="#ffffff" weight="BOLD">12</Font></Text>
        </PartText>
        <PartText width="60" height="24" x="408" y="213">
            <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="14" color="#ffb74d" weight="BOLD">18</Font></Text>
        </PartText>
        <PartText width="60" height="24" x="195" y="412">
            <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="14" color="#90caf9" weight="BOLD">24</Font></Text>
        </PartText>
        <PartText width="60" height="24" x="-18" y="213">
            <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="14" color="#ffb74d" weight="BOLD">6</Font></Text>
        </PartText>

        <!-- Sun Orbiting Marker: Rotates at 15 deg per hour, noon at top (0 deg) -->
        <Group name="solar_track" width="450" height="450" x="0" y="0" pivotX="0.5" pivotY="0.5">
            <Transform target="angle" value="([HOUR_0_23_MINUTE] + 12) * 15 % 360"/>
            <!-- Sun Beam Line -->
            <PartDraw width="450" height="450" x="0" y="0">
                <Variant mode="AMBIENT" target="alpha" value="0"/>
                <Line startX="225" startY="225" endX="225" endY="40">
                    <Stroke color="#8Cffe082" thickness="1"/>
                </Line>
            </PartDraw>
            <!-- Sun Halo Corona -->
            <PartDraw width="34" height="34" x="208" y="23">
                <Variant mode="AMBIENT" target="alpha" value="0"/>
                <Ellipse width="34" height="34" x="0" y="0">
                    <Fill color="#46ffb300"/>
                </Ellipse>
            </PartDraw>
            <!-- Sun Core Disc -->
            <PartDraw width="18" height="18" x="216" y="31">
                <Ellipse width="18" height="18" x="0" y="0">
                    <Fill color="#ffe082"/>
                    <Stroke color="#ffffff" thickness="2"/>
                </Ellipse>
            </PartDraw>
        </Group>

        <!-- Date Display (Centered above Complication) -->
        <PartText width="200" height="26" x="125" y="165">
            <Variant mode="AMBIENT" target="alpha" value="160"/>
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="14" color="#90caf9" weight="SEMI_BOLD">
                    <Template>%s %s
                        <Parameter expression="[DAY_OF_WEEK_S]"/>
                        <Parameter expression="[DAY_OF_MONTH]"/>
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- Complication Slot 0: Center Solar Complication & Angle Reference Provider -->
        <ComplicationSlot slotId="0"
            supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY"
            width="200"
            height="90"
            x="125"
            y="230">
            <DefaultProviderPolicy
                primaryProvider="com.amoledwatchfaces.solarpath/com.amoledwatchfaces.solarpath.complication.SolarPathComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingBox x="0" y="0" width="200" height="90"/>

            <Complication type="SHORT_TEXT">
                <!-- Angle extraction references for the 8 solar arcs -->
                <Group name="ref_ss" x="0" y="0" width="1" height="1" alpha="0">
                    <Transform target="x" value="textLength([COMPLICATION.TITLE]) &gt;= 25 ? round(subText([COMPLICATION.TITLE], 1, 4)) : 98"/>
                    <Reference name="ss_angle" source="x" defaultValue="98"/>
                </Group>
                <Group name="ref_cdusk" x="0" y="0" width="1" height="1" alpha="0">
                    <Transform target="x" value="textLength([COMPLICATION.TITLE]) &gt;= 25 ? round(subText([COMPLICATION.TITLE], 4, 7)) : 106"/>
                    <Reference name="cdusk_angle" source="x" defaultValue="106"/>
                </Group>
                <Group name="ref_ndusk" x="0" y="0" width="1" height="1" alpha="0">
                    <Transform target="x" value="textLength([COMPLICATION.TITLE]) &gt;= 25 ? round(subText([COMPLICATION.TITLE], 7, 10)) : 115"/>
                    <Reference name="ndusk_angle" source="x" defaultValue="115"/>
                </Group>
                <Group name="ref_adusk" x="0" y="0" width="1" height="1" alpha="0">
                    <Transform target="x" value="textLength([COMPLICATION.TITLE]) &gt;= 25 ? round(subText([COMPLICATION.TITLE], 10, 13)) : 124"/>
                    <Reference name="adusk_angle" source="x" defaultValue="124"/>
                </Group>
                <Group name="ref_adawn" x="0" y="0" width="1" height="1" alpha="0">
                    <Transform target="x" value="textLength([COMPLICATION.TITLE]) &gt;= 25 ? round(subText([COMPLICATION.TITLE], 13, 16)) : 256"/>
                    <Reference name="adawn_angle" source="x" defaultValue="256"/>
                </Group>
                <Group name="ref_ndawn" x="0" y="0" width="1" height="1" alpha="0">
                    <Transform target="x" value="textLength([COMPLICATION.TITLE]) &gt;= 25 ? round(subText([COMPLICATION.TITLE], 16, 19)) : 266"/>
                    <Reference name="ndawn_angle" source="x" defaultValue="266"/>
                </Group>
                <Group name="ref_cdawn" x="0" y="0" width="1" height="1" alpha="0">
                    <Transform target="x" value="textLength([COMPLICATION.TITLE]) &gt;= 25 ? round(subText([COMPLICATION.TITLE], 19, 22)) : 275"/>
                    <Reference name="cdawn_angle" source="x" defaultValue="275"/>
                </Group>
                <Group name="ref_sr" x="0" y="0" width="1" height="1" alpha="0">
                    <Transform target="x" value="textLength([COMPLICATION.TITLE]) &gt;= 25 ? round(subText([COMPLICATION.TITLE], 22, 25)) : 283"/>
                    <Reference name="sr_angle" source="x" defaultValue="283"/>
                </Group>

                <!-- Complication Title / Solar Event Label -->
                <PartText width="200" height="24" x="0" y="10">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="14" color="#ffb74d" weight="BOLD">
                            <Template>%s
                                <Parameter expression="textLength([COMPLICATION.TITLE]) &gt; 25 ? subText([COMPLICATION.TITLE], 26, textLength([COMPLICATION.TITLE])) : [COMPLICATION.TITLE]"/>
                            </Template>
                        </Font>
                    </Text>
                </PartText>

                <!-- Complication Text / Solar Event Time -->
                <PartText width="200" height="34" x="0" y="36">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="24" color="#ffffff" weight="BOLD">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="RANGED_VALUE">
                <PartText width="200" height="26" x="0" y="12">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="18" color="#ffffff" weight="BOLD">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartDraw width="120" height="6" x="40" y="44">
                    <RoundRectangle width="120" height="6" x="0" y="0" cornerRadiusX="3" cornerRadiusY="3">
                        <Fill color="#37474f"/>
                    </RoundRectangle>
                    <RoundRectangle width="120" height="6" x="0" y="0" cornerRadiusX="3" cornerRadiusY="3">
                        <Transform target="width" value="120 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0, 1)"/>
                        <Fill color="#ffb74d"/>
                    </RoundRectangle>
                </PartDraw>
            </Complication>

            <Complication type="EMPTY"/>
        </ComplicationSlot>

    </Scene>
</WatchFace>
